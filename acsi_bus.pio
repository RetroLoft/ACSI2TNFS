; ACSI bus PIO programs for the ACSI2TNFS board (Pico, PIO0)
;
; Pin map (PCB):  GP8..GP15 = D0..D7 (through U1 SN74LVC245A)
;                 GP16 = /CS, GP17 = /RESET, GP18 = /ACK, GP19 = A1, GP20 = R/W
;                 GP21 = IRQ transistor (high = /IRQ low)
;                 GP22 = DRQ transistor (high = /DRQ low)
;
; A captured sample is 13 bits: bit0-7 = D0..D7, bit8 = /CS, bit9 = /RESET,
; bit10 = /ACK, bit11 = A1, bit12 = R/W.
;
; Timing (Atari ACSI/DMA Integration Guide, B4):
;   /CS write : data valid 80 ns before /CS falls, /CS low 220..270 ns
;   /CS read  : device data valid at most 100 ns after /CS falls
;   /ACK      : low 220..270 ns; device data valid at most 100 ns after /ACK falls
; We therefore sample ~150 ns after the falling edge (2 sync + 17 cycles @125 MHz),
; which is inside the valid window for both directions.

; ---------------------------------------------------------------------------
; SM0: /CS capture. Also releases /IRQ immediately on every /CS falling edge
; (the guide requires /IRQ inactive within 20 us, ideally < 500 ns).
; set_base = GP21 (IRQ). The CPU asserts IRQ by exec'ing "set pins, 1".
; ---------------------------------------------------------------------------
.program acsi_cs
.wrap_target
    wait 1 gpio 16
    wait 0 gpio 16
    set pins, 0             ; release /IRQ
    nop [15]
    in pins, 13
    push noblock
.wrap

; ---------------------------------------------------------------------------
; SM1: /ACK capture (sniffer + cross-check in target mode).
; Keeps sampling while /ACK is low and pushes the last sample taken before
; the rising edge, so short /ACK pulses are neither missed nor sampled early.
; jmp_pin = GP18 (/ACK).
; ---------------------------------------------------------------------------
.program acsi_ack
.wrap_target
    wait 1 gpio 18
fall:
    wait 0 gpio 18 [2]
    jmp pin fall            ; high again after 3 cycles: a glitch, not a strobe
low:
    mov isr, pins
    jmp pin high
    jmp low
high:
    push noblock
.wrap

; ---------------------------------------------------------------------------
; SM2: DMA data from device to Atari (Atari "read").
; out_base = GP8 (8 pins), set_base = GP22 (DRQ). One byte per FIFO word.
; The byte is on the bus before /DRQ is asserted and stays until /ACK rises.
; Because /DRQ releases slowly (BC547) the ST strobes back to back at full
; speed, so the next byte must follow /ACK's rising edge as fast as possible:
; it is pulled during the /ACK pulse and put out right after the edge.
; Glitch filter: switching all 8 data lines at once (e.g. to 0xFF) right
; after /ACK rises bounces the buffers' ground and shows up as a few-ns low
; glitch on the /ACK input. A falling edge only counts if /ACK is still low
; 3 cycles later (a real strobe is >= 220 ns). jmp_pin = GP18 (/ACK).
; ---------------------------------------------------------------------------
.program acsi_dout
public start:
    pull block              ; first byte
.wrap_target
    out pins, 8             ; byte on the bus (OSR already loaded)
    set pins, 1 [7]         ; assert /DRQ; ignore /ACK while the data lines
                            ; settle (0xFF bounce looked like a strobe and
                            ; made us skip a byte). Real strobes are >= 220 ns.
fall:
    wait 0 gpio 18 [3]      ; host strobes /ACK ...
    jmp pin fall            ; ... unless it is high again: switching noise glitch
    set pins, 0             ; release /DRQ
public fetch:
    pull block              ; fetch the next byte while /ACK is still low
    wait 1 gpio 18 [3]      ; hold the byte ~50 ns after /ACK rises, as the ST
.wrap                       ; does on writes: switching right at the edge gave
                            ; the ST now and then the next byte (1 in 300 KB)

; ---------------------------------------------------------------------------
; SM3: DMA data from Atari to device (Atari "write").
; in_base = GP8, set_base = GP22 (DRQ), jmp_pin = GP18 (/ACK).
; On writes the ST sometimes gives short, back-to-back /ACK pulses (slow
; /DRQ release + DMA FIFO refill), and the byte is not always on the bus at
; the falling edge. So: sample continuously while /ACK is low and keep the
; last value before the rising edge.
; Push the sample from BEFORE the check that saw /ACK high: the newest one may
; have been taken just after the edge, when the ST already puts the next byte
; on the bus (seen: a byte now and then got the value of the byte after it).
; The one before it was taken while /ACK was certainly still low.
; The RX FIFO is emptied by RP2040 DMA, so this SM never stalls.
; ---------------------------------------------------------------------------
.program acsi_din
public start:
.wrap_target
    set pins, 1             ; assert /DRQ
fall:
    wait 0 gpio 18 [2]
    jmp pin fall            ; glitch filter, see acsi_dout
    set pins, 0             ; release /DRQ
    mov isr, pins           ; /ACK is low here
low:
    mov x, isr              ; last sample taken while /ACK was low
    mov isr, pins
    jmp pin high
    jmp low
high:
    mov isr, x
    push block
.wrap

; ---------------------------------------------------------------------------
; PIO1 SM0: logic analyser. 16 pins from GP8 (D0-D7, /CS, /RESET, /ACK, A1,
; R/W, IRQ out, DRQ out, GP23) every PIO clock; two samples per FIFO word.
; ---------------------------------------------------------------------------
.program acsi_la
.wrap_target
    in pins, 16
.wrap
